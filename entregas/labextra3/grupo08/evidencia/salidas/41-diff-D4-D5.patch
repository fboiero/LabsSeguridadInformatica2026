+    @staticmethod
+    def _ruta_confinada(nombre):
+        """D5: devuelve la ruta real del archivo pedido solo si queda DENTRO de
+        DESCARGAS y es un archivo regular; en cualquier otro caso, None.
+
+        Se valida el DESTINO, no el texto del pedido:
+          1. realpath resuelve "..", "." y symlinks -> ruta canónica.
+             (parse_qs ya decodificó %2e%2e%2f una vez; no se decodifica de
+             nuevo, así que %252e queda como nombre literal inexistente).
+          2. commonpath exige que la raíz sea ancestro de la ruta. No se usa
+             startswith: "/tmp/phantom_descargas_secreto" empieza con
+             "/tmp/phantom_descargas" y pasaría. Esto también frena rutas
+             absolutas, porque os.path.join("/raiz", "/etc/passwd") descarta
+             la raíz y da "/etc/passwd".
+          3. isfile: solo archivos regulares (no directorios ni dispositivos).
+        """
+        raiz = os.path.realpath(DESCARGAS)
+        try:
+            ruta = os.path.realpath(os.path.join(raiz, nombre))
+        except ValueError:          # byte nulo (%00) en el nombre
+            return None
+        if os.path.commonpath([raiz, ruta]) != raiz:
+            return None
+        if not os.path.isfile(ruta):
+            return None
+        return ruta
+
