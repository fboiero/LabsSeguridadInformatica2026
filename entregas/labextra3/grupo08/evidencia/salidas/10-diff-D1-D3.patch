+    def _backup_autorizado(self):
+        """D3: HTTP Basic contra credenciales de entorno, comparación en
+        tiempo constante. Sin credenciales configuradas -> nunca autoriza."""
+        if not (BACKUP_USER and BACKUP_PASS):
